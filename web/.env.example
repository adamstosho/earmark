# Copy to web/.env.local for development. On Vercel, set the same names as environment variables.
# Network: arcTestnet (5042002) or arcMainnet (5042).
VITE_NETWORK=arcTestnet
# EarmarkPockets address from deployments/arc-<network>.json (the values below are the Arc testnet deployment).
VITE_POCKETS_ADDRESS=0x68C480758172bBC94858B98F6E5E356FA30e3080
# Block the contract was deployed in (deployments/arc-<network>.json).
VITE_DEPLOY_BLOCK=64978753
# Public Arc RPC: https://rpc.testnet.arc.io or https://rpc.mainnet.arc.io
VITE_RPC_URL=https://rpc.testnet.arc.io
# Optional: a pocket id for "See a live pocket" on the landing page. Leave empty to hide it.
VITE_DEMO_POCKET_ID=
